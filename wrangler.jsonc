{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Debe coincidir con el nombre del Worker en Cloudflare (fuyu.fuyudatos.workers.dev)
  "name": "fuyu",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",

  // Archivos del sitio. Solo /api/* pasa por el código del Worker.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // Configuración editable sin tocar código.
  // La clave GROQ_API_KEY NO va aquí: es un secreto (ver README).
  "vars": {
    "GROQ_MODELO_TEXTO": "openai/gpt-oss-120b",
    "GROQ_MODELO_VISION": "qwen/qwen3.8-27b",
    "GROQ_URL": "https://api.groq.com/openai/v1",
    "LIMITE_POR_HORA": "20",
    "TAMANO_MAXIMO_BYTES": "2097152"
  },

  // Contador de pedidos por IP y por hora (solo guarda un número, nunca documentos)
  "durable_objects": {
    "bindings": [{ "name": "LIMITE_IP", "class_name": "LimiteIP" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LimiteIP"] }],

  "observability": { "enabled": true }
}
